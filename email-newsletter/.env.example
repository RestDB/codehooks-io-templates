# ── Required secrets ────────────────────────────────────────────────
# Set these with: coho set-env KEY value --encrypted
# (omit --encrypted for non-secret values)

# ── Email provider ──────────────────────────────────────────────────
# Which provider to send through: mailgun | brevo (default: mailgun).
# Set ONLY the env vars for the provider you choose.
EMAIL_PROVIDER=mailgun

# --- Mailgun --- https://app.mailgun.com → Sending → Domain settings → API keys
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=mg.yourdomain.com
# Set to "true" only if your Mailgun account is in the EU region
MAILGUN_EU=false

# --- Brevo --- https://app.brevo.com → SMTP & API → API Keys
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx

# Admin auth
# JWT_SECRET: any long random string — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
# Password you'll type to log in to the /admin UI
ADMIN_PASSWORD=choose-a-strong-password

# ── Optional ────────────────────────────────────────────────────────
# These can also be set in the admin Settings UI (which takes precedence).
# Without them, the app falls back to these env vars.

# Default sender — FROM_EMAIL must be on a Mailgun-authorized domain
FROM_EMAIL=noreply@mg.yourdomain.com
FROM_NAME=My Newsletter

# Absolute base URL of this deployment — used to build confirm/unsubscribe
# links in emails. Find it with: coho info
# If unset, it's derived from the incoming request for signup confirmations,
# but campaigns (sent from a background worker) REQUIRE it to be configured
# either here or in Settings.
BASE_URL=https://your-app.codehooks.io
