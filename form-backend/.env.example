# form-backend — environment variables
#
# Set these on your Codehooks space, not in a file:
#
#   coho set-env ADMIN_PASSWORD 'your-password' --encrypted
#   coho set-env JWT_SECRET "$(openssl rand -hex 32)" --encrypted
#
# Use --encrypted for every secret. Values without it are readable from the CLI.
# Redeploy after changing any of these: coho deploy


# ─── Required ────────────────────────────────────────────────────────────────

# Password for the admin dashboard at /setup/. There is no user list and no
# password reset — this single value is the whole admin credential.
ADMIN_PASSWORD=

# Signs admin session cookies AND the per-file download links in notification
# emails. Generate 32+ random bytes; never reuse a value from another service.
#   openssl rand -hex 32
# Changing it signs out every admin session and invalidates every download link
# already sent in an email.
JWT_SECRET=


# ─── Required once you turn on email notifications ───────────────────────────

# The public URL of this deployment, with scheme and no trailing slash, e.g.
#   https://api.example.com
# Notification emails build their file-download links from this. It cannot be
# derived from the request, because notifications are sent from a background
# worker that has no incoming request to read a host header from.
#
# If this is unset, deliveries fail with lastError "BASE_URL is not configured"
# rather than sending an email containing broken links.
BASE_URL=

# Which provider sends the mail: brevo (default) or mailgun.
EMAIL_PROVIDER=brevo

# The From: address. This must be an address your provider has VERIFIED as a
# sender. An unverified sender is rejected with a 4xx and the delivery is
# recorded failed — no amount of retrying fixes it.
FROM_EMAIL=

# Display name on the From: header. Default: Form Backend
FROM_NAME=

# --- Brevo (when EMAIL_PROVIDER=brevo) ---
# Set with --encrypted.
#
# If your Brevo account has IP authorisation enabled, turn it OFF. Serverless
# egress addresses rotate, and a rejection from that check arrives as a 4xx —
# which is treated as permanent, so notifications stop silently rather than
# being retried. Allowlisting an address only postpones this.
BREVO_API_KEY=

# --- Mailgun (when EMAIL_PROVIDER=mailgun) ---
# Set MAILGUN_API_KEY with --encrypted.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Set to true if your Mailgun account is in the EU region. Default: false
MAILGUN_EU=false


# ─── Optional tuning ─────────────────────────────────────────────────────────

# Largest single upload accepted by a form, in megabytes. Default: 5
MAX_UPLOAD_MB=5

# Total attachment budget per notification email, in megabytes. Default: 10
# Files are packed smallest-first; anything that does not fit is not dropped —
# it is named in the email with a signed download link instead. Keep this under
# your provider's own limit (Mailgun 25 MB; Brevo is lower).
MAX_ATTACH_MB=10

# Submissions allowed per IP, per form, per hour before a 429. Default: 30
# If the throttle store is unavailable the request is ALLOWED, so a key-value
# outage cannot take a customer's contact form offline.
SUBMIT_RATE_LIMIT=30
